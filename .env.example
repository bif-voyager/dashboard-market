APP_ENV=development
API_PORT=8000
SQLITE_PATH=data/dashboard.db
REQUEST_TIMEOUT_SECONDS=20
FETCH_CONCURRENCY=2

POLY_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLY_DATA_BASE_URL=https://data-api.polymarket.com
POLY_PAGE_LIMIT=500
POLY_RECENT_MAX_PAGES=3
POLY_BOOTSTRAP_MAX_PAGES=3
POLY_METADATA_RECENT_MAX_PAGES=120
POLY_METADATA_BOOTSTRAP_MAX_PAGES=120

KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_PAGE_LIMIT=500
KALSHI_RECENT_MAX_PAGES=16
KALSHI_BOOTSTRAP_MAX_PAGES=120
KALSHI_EVENT_RECENT_MAX_PAGES=18
KALSHI_EVENT_BOOTSTRAP_MAX_PAGES=180
KALSHI_DIRECT_MARKET_RECENT_MAX_PAGES=120
KALSHI_DIRECT_MARKET_BOOTSTRAP_MAX_PAGES=300
KALSHI_HISTORICAL_MARKET_RECENT_MAX_PAGES=18
KALSHI_HISTORICAL_MARKET_BOOTSTRAP_MAX_PAGES=180
KALSHI_CANDLESTICK_CHUNK_SIZE=100

SYNC_ON_STARTUP=true
SYNC_START_SCOPE=recent
ENABLE_CSV_EXPORT=true
APP_TIMEZONE=UTC
VITE_API_BASE_URL=http://localhost:8000
